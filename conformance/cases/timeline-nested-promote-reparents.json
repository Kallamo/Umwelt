{
  "name": "timeline-nested-promote-reparents",
  "steps": [
    {
      "request": {
        "op": "hello",
        "payload": {
          "protocol": {
            "min": 1,
            "max": 1
          },
          "client": "conformance/1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "protocol": 1,
          "engine": "$any"
        }
      }
    },
    {
      "request": {
        "op": "project.create",
        "payload": {
          "id": "p",
          "name": "Test",
          "timescale": "day",
          "vocabularyMode": "open"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "version": 0
        }
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "agent",
          "name": "agent",
          "kind": "agent"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "group",
          "name": "group",
          "kind": "group"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "other",
          "name": "other",
          "kind": "other"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "alice",
          "typeId": "agent",
          "name": "alice"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "bob",
          "typeId": "agent",
          "name": "bob"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "team",
          "typeId": "group",
          "name": "team"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "item",
          "typeId": "other",
          "name": "item"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "predicate.define",
        "payload": {
          "projectId": "p",
          "predicate": {
            "id": "related",
            "label": "Related",
            "object": "entity",
            "cardinality": "many"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "d1",
          "kind": "draft",
          "status": "active",
          "baseVersion": "$any"
        }
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d2",
          "baseTimelineId": "d1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "d2",
          "kind": "draft",
          "status": "active",
          "parentTimelineId": "d1"
        }
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d3",
          "baseTimelineId": "d2"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "d3",
          "kind": "draft",
          "status": "active",
          "parentTimelineId": "d2",
          "depth": 3
        }
      }
    },
    {
      "request": {
        "op": "commit",
        "payload": {
          "projectId": "p",
          "attemptId": "a1",
          "event": {
            "id": "e-a1",
            "type": "test",
            "title": "Mira's lantern",
            "position": {
              "tick": 1
            },
            "provenance": {
              "origin": {
                "kind": "human"
              }
            }
          },
          "records": [
            {
              "kind": "holding",
              "id": "h1",
              "position": {
                "tick": 1
              },
              "provenance": {
                "origin": {
                  "kind": "human"
                }
              },
              "holder": "alice",
              "attitude": "believes",
              "claim": {
                "subject": "alice",
                "predicate": "related",
                "object": {
                  "kind": "entity",
                  "id": "item"
                },
                "polarity": true
              },
              "acquisition": {
                "kind": "authored"
              },
              "confidence": 1,
              "accessibility": "available"
            }
          ],
          "transitions": [],
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "timeline.promote",
        "payload": {
          "projectId": "p",
          "timelineId": "d2"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "status": "promoted"
        }
      }
    },
    {
      "request": {
        "op": "timeline.get",
        "payload": {
          "projectId": "p",
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "parentTimelineId": "d1",
          "depth": 2
        }
      }
    },
    {
      "request": {
        "op": "holds",
        "payload": {
          "projectId": "p",
          "holder": "alice",
          "claim": {
            "subject": "alice",
            "predicate": "related",
            "object": {
              "kind": "entity",
              "id": "item"
            },
            "polarity": true
          },
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "holds": true
        }
      }
    },
    {
      "request": {
        "op": "changes",
        "payload": {
          "projectId": "p",
          "timelineId": "d1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "type": "timeline.promoted",
              "timelineId": "d1",
              "payload": {
                "timelineId": "d2",
                "into": "d1",
                "reparented": [
                  "d3"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "op": "timeline.promote",
        "payload": {
          "projectId": "p",
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "status": "promoted"
        }
      }
    },
    {
      "request": {
        "op": "holds",
        "payload": {
          "projectId": "p",
          "holder": "alice",
          "claim": {
            "subject": "alice",
            "predicate": "related",
            "object": {
              "kind": "entity",
              "id": "item"
            },
            "polarity": true
          },
          "timelineId": "d1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "holds": true
        }
      }
    },
    {
      "request": {
        "op": "holds",
        "payload": {
          "projectId": "p",
          "holder": "alice",
          "claim": {
            "subject": "alice",
            "predicate": "related",
            "object": {
              "kind": "entity",
              "id": "item"
            },
            "polarity": true
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "holds": false
        }
      }
    },
    {
      "request": {
        "op": "holds",
        "payload": {
          "projectId": "p",
          "holder": "alice",
          "claim": {
            "subject": "alice",
            "predicate": "related",
            "object": {
              "kind": "entity",
              "id": "item"
            },
            "polarity": true
          },
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "INVALID_STATE",
          "details": {
            "promotedInto": "d1"
          }
        }
      }
    },
    {
      "request": {
        "op": "timeline.promote",
        "payload": {
          "projectId": "p",
          "timelineId": "d1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "status": "promoted"
        }
      }
    },
    {
      "request": {
        "op": "holds",
        "payload": {
          "projectId": "p",
          "holder": "alice",
          "claim": {
            "subject": "alice",
            "predicate": "related",
            "object": {
              "kind": "entity",
              "id": "item"
            },
            "polarity": true
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "holds": true
        }
      }
    }
  ]
}
