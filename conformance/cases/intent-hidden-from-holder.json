    {
      "request": {
        "op": "compare",
        "payload": {
          "projectId": "p",
          "a": "bob",
          "b": "alice"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "shared": [
            {
              "a": {
                "id": "h2",
                "acquisition": {
                  "kind": "told-by",
                  "sourceHolderId": "alice",
                  "sourceRecordId": "h1",
                  "intent": "unknown"
                }
              },
              "b": {
                "id": "h1"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "op": "search",
        "payload": {
          "projectId": "p",
          "text": "falsehood",
          "filter": {
            "holder": "bob"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "docId": "h2",
              "record": {
                "acquisition": {
                  "kind": "told-by",
                  "sourceHolderId": "alice",
                  "sourceRecordId": "h1",
                  "intent": "unknown"
                }
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "op": "trace",
        "payload": {
          "projectId": "p",
          "recordId": "h2"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "chain": [
            {
              "record": {
                "id": "h2"
              },
              "acquisition": {
                "kind": "told-by",
                "intent": "deceptive"
              }
            },
            {
              "record": {
                "id": "h1"
              }
            }
          ]
        }
      }
    }
