        }
      }
    },
    {
      "request": {
        "op": "holdings",
        "payload": {
          "projectId": "p",
          "holder": "bob"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "record": {
                "id": "h2",
                "acquisition": {
                  "kind": "told-by",
                  "sourceHolderId": "alice",
                  "sourceRecordId": "h1",
                  "intent": "unknown"
                }
              },
              "acquisition": {
                "kind": "told-by",
                "sourceHolderId": "alice",
                "sourceRecordId": "h1",
                "intent": "unknown"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "op": "perspective",
        "payload": {
          "projectId": "p",
          "holder": "bob"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "holdings": [
            {
              "record": {
                "id": "h2",
                "acquisition": {
                  "kind": "told-by",
                  "sourceHolderId": "alice",
                  "sourceRecordId": "h1",
