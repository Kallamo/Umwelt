        "payload": {
          "projectId": "p",
          "id": "other",
          "name": "other",
          "kind": "other"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "alice",
          "typeId": "agent",
          "name": "alice"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "bob",
          "typeId": "agent",
          "name": "bob"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "team",
          "typeId": "group",
          "name": "team"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "item",
          "typeId": "other",
          "name": "item"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "predicate.define",
        "payload": {
          "projectId": "p",
          "predicate": {
            "id": "related",
            "label": "Related",
            "object": "entity",
            "cardinality": "many"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "embedding.defineSpace",
        "payload": {
          "projectId": "p",
          "space": {
            "id": "s",
            "dimensions": 3,
            "model": "hand-made"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "s",
          "dimensions": 3
        }
      }
    },
    {
      "request": {
        "op": "commit",
        "payload": {
          "projectId": "p",
          "attemptId": "a1",
          "event": {
            "id": "e-a1",
            "type": "test",
            "title": "Mira's lantern",
            "position": {
              "tick": 1
            },
            "provenance": {
              "origin": {
                "kind": "human"
              }
            }
          },
          "records": [
            {
              "kind": "holding",
              "id": "jewel",
              "position": {
                "tick": 1
              },
              "provenance": {
                "origin": {
                  "kind": "human"
                }
              },
              "holder": "alice",
              "attitude": "believes",
              "claim": {
                "subject": "alice",
                "predicate": "related",
                "object": {
                  "kind": "entity",
                  "id": "item"
                },
                "polarity": true
              },
              "acquisition": {
                "kind": "authored"
              },
              "confidence": 1,
              "accessibility": "available",
              "text": "someone took the jewel"
            },
            {
              "kind": "holding",
              "id": "silent",
              "position": {
                "tick": 1
              },
              "provenance": {
                "origin": {
                  "kind": "human"
                }
              },
              "holder": "alice",
              "attitude": "believes",
              "claim": {
                "subject": "alice",
                "predicate": "related",
                "object": {
                  "kind": "entity",
                  "id": "item"
                },
                "polarity": true
              },
              "acquisition": {
                "kind": "authored"
              },
              "confidence": 1,
              "accessibility": "available"
            }
          ],
          "transitions": []
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "embedding.pending",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "docTypes": [
            "record"
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "docType": "record",
              "docId": "jewel",
              "text": "someone took the jewel",
              "textHash": "c94bb0eb1650b8d362903510dddc01bbd0df8a556d17bbd63b2db4d307a2e82b",
              "stale": false
            }
          ],
          "resumeCursor": "$any"
        }
      }
    },
    {
      "request": {
        "op": "embedding.put",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "items": [
            {
              "docType": "record",
              "docId": "jewel",
              "textHash": "dc45fa57ae5c00dc13bf6781647e249e2f7e87072dd070759a0fd2a2e2bde83d",
              "vector": [
                1,
                0,
                0
              ]
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "stored": 1,
          "stale": 1
        }
      }
    },
    {
      "request": {
        "op": "embedding.pending",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "docTypes": [
            "record"
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "docId": "jewel",
              "stale": true
            }
          ]
        }
      }
    },
    {
      "request": {
        "op": "embedding.put",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "items": [
            {
              "docType": "record",
              "docId": "jewel",
              "textHash": "c94bb0eb1650b8d362903510dddc01bbd0df8a556d17bbd63b2db4d307a2e82b",
              "vector": [
                1,
                0,
                0
              ]
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "stored": 1,
          "stale": 0
        }
      }
    },
    {
      "request": {
        "op": "embedding.pending",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "docTypes": [
            "record"
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": []
        }
      }
    },
    {
      "request": {
        "op": "embedding.put",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "items": [
            {
              "docType": "record",
              "docId": "silent",
              "textHash": "2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881",
              "vector": [
                1,
                0,
                0
              ]
            }
          ]
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "VALIDATION_FAILED"
        }
      }
    },
    {
      "request": {
        "op": "embedding.put",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "items": [
            {
              "docType": "record",
              "docId": "jewel",
              "textHash": "2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881",
              "vector": [
                0,
                0,
                0
              ]
            }
          ]
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "VALIDATION_FAILED"
        }
      }
    },
    {
      "request": {
        "op": "embedding.delete",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "items": [
            {
              "docType": "record",
              "docId": "jewel"
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "removed": 1
        }
      }
    },
    {
      "request": {
        "op": "embedding.pending",
        "payload": {
          "projectId": "p",
          "spaceId": "s",
          "docTypes": [
            "record"
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "docId": "jewel",
