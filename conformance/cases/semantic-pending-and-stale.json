{
  "name": "semantic-pending-and-stale",
  "steps": [
    {
      "request": {
        "op": "hello",
        "payload": {
          "protocol": {
            "min": 1,
            "max": 1
          },
          "client": "conformance/1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "protocol": 1,
          "engine": "$any"
        }
      }
    },
    {
      "request": {
        "op": "project.create",
        "payload": {
          "id": "p",
          "name": "Test",
          "timescale": "day",
          "vocabularyMode": "open"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "version": 0
        }
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "agent",
          "name": "agent",
          "kind": "agent"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "group",
