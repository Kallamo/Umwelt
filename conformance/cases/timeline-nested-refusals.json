{
  "name": "timeline-nested-refusals",
  "steps": [
    {
      "request": {
        "op": "hello",
        "payload": {
          "protocol": {
            "min": 1,
            "max": 1
          },
          "client": "conformance/1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "protocol": 1,
          "engine": "$any"
        }
      }
    },
    {
      "request": {
        "op": "project.create",
        "payload": {
          "id": "p",
          "name": "Test",
          "timescale": "day",
          "vocabularyMode": "open"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "version": 0
        }
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "agent",
          "name": "agent",
          "kind": "agent"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "group",
          "name": "group",
          "kind": "group"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "other",
          "name": "other",
          "kind": "other"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "alice",
          "typeId": "agent",
          "name": "alice"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "bob",
          "typeId": "agent",
          "name": "bob"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "team",
          "typeId": "group",
          "name": "team"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "item",
          "typeId": "other",
          "name": "item"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "predicate.define",
        "payload": {
          "projectId": "p",
          "predicate": {
            "id": "related",
            "label": "Related",
            "object": "entity",
            "cardinality": "many"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "d1",
          "kind": "draft",
          "status": "active",
          "baseVersion": "$any"
        }
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d2",
          "baseTimelineId": "d1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "d2",
          "kind": "draft",
          "status": "active",
          "parentTimelineId": "d1"
        }
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d3",
          "baseTimelineId": "d2"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "d3",
          "kind": "draft",
          "status": "active",
          "parentTimelineId": "d2"
        }
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d4",
          "baseTimelineId": "d3"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "d4",
          "kind": "draft",
          "status": "active",
          "parentTimelineId": "d3",
          "depth": 4
        }
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d5",
          "baseTimelineId": "d4"
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "VALIDATION_FAILED",
          "details": {
            "maxDepth": 4,
            "parentTimelineId": "d4"
          }
        }
      }
    },
    {
      "request": {
        "op": "timeline.discard",
        "payload": {
          "projectId": "p",
          "timelineId": "d1"
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "INVALID_STATE",
          "details": {
            "descendants": [
              "d2",
              "d3",
              "d4"
            ]
          }
        }
      }
    },
    {
      "request": {
        "op": "timeline.discard",
        "payload": {
          "projectId": "p",
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "INVALID_STATE",
          "details": {
            "descendants": [
              "d4"
            ]
          }
        }
      }
    },
    {
      "request": {
        "op": "timeline.discard",
        "payload": {
          "projectId": "p",
          "timelineId": "d4"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "status": "discarded"
        }
      }
    },
    {
      "request": {
        "op": "timeline.discard",
        "payload": {
          "projectId": "p",
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "status": "discarded"
        }
      }
    },
    {
      "request": {
        "op": "timeline.purge",
        "payload": {
          "projectId": "p",
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "INVALID_STATE",
          "details": {
            "descendants": [
              "d4"
            ]
          }
        }
      }
    },
    {
      "request": {
        "op": "timeline.purge",
        "payload": {
          "projectId": "p",
          "timelineId": "d4"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "purged": true
        }
      }
    },
    {
      "request": {
        "op": "timeline.purge",
        "payload": {
          "projectId": "p",
          "timelineId": "d3"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "purged": true
        }
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d5",
          "baseTimelineId": "d3"
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "NOT_FOUND"
        }
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d5",
          "baseTimelineId": "missing"
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "NOT_FOUND"
        }
      }
    }
  ]
}
