          "name": "alice"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "bob",
          "typeId": "agent",
          "name": "bob"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "team",
          "typeId": "group",
          "name": "team"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "item",
          "typeId": "other",
          "name": "item"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "predicate.define",
        "payload": {
          "projectId": "p",
          "predicate": {
            "id": "related",
            "label": "Related",
            "object": "entity",
            "cardinality": "many"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "commit",
        "payload": {
          "projectId": "p",
          "attemptId": "a1",
          "event": {
            "id": "e-a1",
            "type": "test",
            "title": "Mira's lantern",
            "position": {
              "tick": 1
            },
            "provenance": {
              "origin": {
                "kind": "human"
              }
            }
          },
          "records": [
            {
              "kind": "fact",
              "id": "m1",
              "position": {
                "tick": 1
              },
              "provenance": {
                "origin": {
                  "kind": "human"
                }
              },
              "claim": {
                "subject": "alice",
                "predicate": "umwelt:member-of",
                "object": {
                  "kind": "entity",
                  "id": "team"
                },
                "polarity": true
              }
            }
          ],
          "transitions": []
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "witness",
        "payload": {
          "projectId": "p",
          "attemptId": "w1",
          "event": {
            "id": "e-w1",
            "type": "scene",
            "title": "Fire",
            "position": {
              "tick": 2
            },
            "provenance": {
              "origin": {
                "kind": "human"
              }
            }
          },
          "claims": [
            {
              "claim": {
                "subject": "alice",
                "predicate": "related",
                "object": {
                  "kind": "entity",
                  "id": "item"
                },
                "polarity": true
              },
              "canon": true,
              "factId": "f-fire"
            }
          ],
          "witnesses": [
            {
              "holder": "alice",
              "recordIds": [
                "w-alice"
              ]
            },
            {
              "holder": "bob",
              "attitude": "suspects",
              "confidence": 0.5,
              "accessibility": "available"
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "eventId": "e-w1",
          "recordIds": [
            "f-fire",
            "w-alice",
            "$any"
          ]
        }
      }
    },
    {
      "request": {
        "op": "witness",
        "payload": {
          "projectId": "p",
          "attemptId": "w1",
          "event": {
            "id": "e-w1",
            "type": "scene",
            "title": "Fire",
            "position": {
              "tick": 2
            },
            "provenance": {
              "origin": {
                "kind": "human"
              }
            }
          },
          "claims": [
            {
              "claim": {
                "subject": "alice",
                "predicate": "related",
                "object": {
                  "kind": "entity",
                  "id": "item"
                },
                "polarity": true
              },
              "canon": true,
              "factId": "f-fire"
            }
          ],
          "witnesses": [
            {
              "holder": "alice",
              "recordIds": [
                "w-alice"
              ]
            },
            {
              "holder": "bob",
              "attitude": "suspects",
              "confidence": 0.5,
              "accessibility": "available"
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "eventId": "e-w1"
        }
      }
    },
    {
      "request": {
        "op": "holds",
        "payload": {
          "projectId": "p",
          "holder": "bob",
          "claim": {
            "subject": "alice",
            "predicate": "related",
            "object": {
              "kind": "entity",
              "id": "item"
            },
            "polarity": true
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "holds": true
        }
      }
    },
    {
      "request": {
        "op": "whoHolds",
        "payload": {
          "projectId": "p",
          "claim": {
            "subject": "alice",
            "predicate": "related",
            "object": {
              "kind": "entity",
              "id": "item"
            },
            "polarity": true
          },
          "filter": {
            "memberOf": "team"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": [
          {
            "holder": "alice",
            "recordId": "w-alice"
          }
        ]
      }
    },
    {
      "request": {
        "op": "groupCoverage",
        "payload": {
          "projectId": "p",
          "group": "team",
          "claim": {
            "subject": "alice",
            "predicate": "related",
            "object": {
              "kind": "entity",
              "id": "item"
            },
            "polarity": true
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "members": [
            "alice"
          ],
          "holding": [
            {
              "holder": "alice"
            }
          ],
          "missing": []
        }
      }
    }
  ]
}
