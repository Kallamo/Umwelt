      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "id": "e-rb"
            },
            {
              "id": "e-rc"
            }
          ]
        }
      }
    },
    {
      "request": {
        "op": "search",
        "payload": {
          "projectId": "p",
          "text": "lantern",
          "filter": {
            "docType": "event"
          },
          "at": {
            "axis": "reading"
