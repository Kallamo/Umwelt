{
  "name": "participants-follow-rebase",
  "steps": [
    {
      "request": {
        "op": "hello",
        "payload": {
          "protocol": {
            "min": 1,
            "max": 1
          },
          "client": "conformance/1"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "protocol": 1,
          "engine": "$any"
        }
      }
    },
    {
      "request": {
        "op": "project.create",
        "payload": {
          "id": "p",
          "name": "Test",
          "timescale": "day",
          "vocabularyMode": "open"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "version": 0
        }
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "agent",
          "name": "agent",
          "kind": "agent"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "group",
          "name": "group",
          "kind": "group"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entityType.create",
        "payload": {
          "projectId": "p",
          "id": "other",
          "name": "other",
          "kind": "other"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "alice",
          "typeId": "agent",
          "name": "alice"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "bob",
          "typeId": "agent",
          "name": "bob"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "team",
          "typeId": "group",
          "name": "team"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "entity.create",
        "payload": {
          "projectId": "p",
          "id": "item",
          "typeId": "other",
          "name": "item"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "predicate.define",
        "payload": {
          "projectId": "p",
          "predicate": {
            "id": "related",
            "label": "Related",
            "object": "entity",
            "cardinality": "many"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "timeline.openDraft",
        "payload": {
          "projectId": "p",
          "id": "d"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "d",
          "kind": "draft",
          "status": "active",
          "baseVersion": "$any"
        }
      }
    },
    {
      "request": {
        "op": "commit",
        "payload": {
          "projectId": "p",
          "attemptId": "in-d",
          "event": {
            "id": "e-in-d",
            "type": "scene",
            "title": "The lantern in-d",
            "position": {
              "tick": 2
            },
            "provenance": {
              "origin": {
                "kind": "human"
              }
            },
            "participants": [
              "alice"
            ]
          },
          "records": [
            {
              "kind": "fact",
              "id": "f-in-d",
              "position": {
                "tick": 2
              },
              "provenance": {
                "origin": {
                  "kind": "human"
                }
              },
              "claim": {
                "subject": "alice",
                "predicate": "related",
                "object": {
                  "kind": "entity",
                  "id": "item"
                },
                "polarity": true
              }
            }
          ],
          "timelineId": "d"
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "commit",
        "payload": {
          "projectId": "p",
          "attemptId": "in-main",
          "event": {
            "id": "e-in-main",
            "type": "scene",
            "title": "The lantern in-main",
            "position": {
              "tick": 3
            },
            "provenance": {
              "origin": {
                "kind": "human"
              }
            },
            "participants": [
              "bob"
            ]
          },
          "records": [
            {
              "kind": "fact",
              "id": "f-in-main",
              "position": {
                "tick": 3
              },
              "provenance": {
                "origin": {
                  "kind": "human"
                }
              },
              "claim": {
                "subject": "bob",
                "predicate": "related",
                "object": {
                  "kind": "entity",
                  "id": "item"
                },
                "polarity": true
              }
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {}
      }
    },
    {
      "request": {
        "op": "timeline.rebase",
        "payload": {
          "projectId": "p",
          "timelineId": "d"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "status": "active"
        }
      }
    },
    {
      "request": {
        "op": "timeline",
        "payload": {
          "projectId": "p",
          "timelineId": "d",
          "participant": "alice"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "id": "e-in-d"
            }
          ]
        }
      }
    },
    {
      "request": {
        "op": "timeline",
        "payload": {
          "projectId": "p",
          "timelineId": "d",
          "participant": "bob"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": [
            {
              "id": "e-in-main"
            }
          ]
        }
      }
    },
    {
      "request": {
        "op": "timeline",
        "payload": {
          "projectId": "p",
          "participant": "alice"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "items": []
        }
      }
    }
  ]
}
