            {
              "id": "hidden",
              "eventId": "e-a1",
              "classification": "spoiler"
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "admitted": [
            {
              "id": "big",
              "cost": 3,
              "priority": 9
            }
          ],
          "rejected": [
            {
              "id": "cheap",
              "reason": "over-budget"
            },
            {
              "id": "hidden",
              "reason": "excluded-classification"
            }
          ],
          "usedBudget": 3
        }
      }
