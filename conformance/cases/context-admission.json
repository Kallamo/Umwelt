          ]
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "admitted": [
            {
              "id": "a"
            }
          ],
          "rejected": [
            {
              "id": "b",
              "reason": "not-held"
            },
            {
              "id": "c",
              "reason": "not-held"
            }
          ],
          "usedBudget": 1
        }
      }
    },
    {
      "request": {
        "op": "context.admit",
        "payload": {
          "projectId": "p",
          "holder": "alice",
          "includeWithheld": true,
          "candidates": []
        }
      },
      "expect": {
        "ok": false,
        "error": {
          "code": "VALIDATION_FAILED"
        }
      }
    },
    {
      "request": {
        "op": "context.admit",
        "payload": {
          "projectId": "p",
          "budget": 3,
          "excludeClassifications": [
            "spoiler"
