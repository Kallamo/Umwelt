                "tick": 0
              }
            },
            {
              "externalRef": {
                "system": "game",
                "id": "Theo"
              },
              "typeId": "agent",
              "name": "Theo"
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": [
          {
            "created": true,
            "entity": {
              "id": "mira",
              "aliases": [
                "Mi"
              ]
            }
          },
          {
            "created": true
          }
        ]
