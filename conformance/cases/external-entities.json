    },
    {
      "request": {
        "op": "entity.ensureBatch",
        "payload": {
          "projectId": "p",
          "entities": [
            {
              "externalRef": {
                "system": "game",
                "id": "Mira"
              },
              "typeId": "agent",
              "name": "Mira C."
            },
            {
              "externalRef": {
                "system": "game",
                "id": "Theo"
              },
              "typeId": "agent",
              "name": "Theo"
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": [
          {
            "created": false,
            "entity": {
              "id": "mira",
              "name": "Mira C."
            }
          },
          {
            "created": false
          }
        ]
      }
    },
    {
      "request": {
        "op": "entity.resolve",
        "payload": {
          "projectId": "p",
          "externalRef": {
            "system": "game",
            "id": "Mira"
          }
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": "mira",
          "name": "Mira C."
        }
      }
    },
    {
      "request": {
        "op": "entity.resolveBatch",
        "payload": {
          "projectId": "p",
          "externalRefs": [
            {
              "system": "game",
              "id": "Mira"
            },
            {
              "system": "game",
              "id": "Nobody"
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "result": [
          {
            "entityId": "mira"
          },
          {
            "externalRef": {
              "id": "Nobody"
            }
          }
        ]
      }
